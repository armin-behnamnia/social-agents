# ============================================================================
# LLM / Embedding API access — copy this file to .env and fill in your
# credentials:   cp .env.example .env
# The .env file is GITIGNORED and must never be committed.
#
# Works with any OpenAI-compatible endpoint:
#   - OpenAI:        LLM_BASE_URL=https://api.openai.com/v1
#   - Together:      LLM_BASE_URL=https://api.together.xyz/v1
#   - OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1
#   - vLLM server:   LLM_BASE_URL=http://<host>:<port>/v1
# ============================================================================

# --- LLM (message rendering, personas, observer) ------------------------------
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=gpt-4o-mini

# --- Embeddings (same format unless your provider differs) ---------------------
# If unset, EMBEDDING_* falls back to LLM_BASE_URL / LLM_API_KEY.
#EMBEDDING_BASE_URL=https://api.example.com/v1
#EMBEDDING_API_KEY=sk-REPLACE_ME
EMBEDDING_MODEL=text-embedding-3-small

# --- Optional overrides (defaults shown) -------------------------------------
# Number of concurrent LLM render workers (live mode only)
# LLM_MAX_WORKERS=8
