+/**
+ * Simulation variables (social-agents sidecar).
+ *
+ * The dashboard's Twitter schema has no opinion variables, so the
+ * exporter also ships `agent_variables_50_repub_<run>.json`: one record
+ * per agent holding a time series per variable (index i = the population
+ * snapshot after period i, i.e. dashboard iteration i) plus the log of
+ * influence events the agent received. This panel is what makes a node
+ * description show the *simulation* and not only the tweet traffic --
+ * above all the agent's **current stance**, read at whatever iteration
+ * the timeline is currently showing.
+ *
+ * The file is optional, like the other per-run sidecars: for runs that do
+ * not have it (and for the upstream runs) the fetch 404s, the panel
+ * simply does not render, and nothing else changes.
+ */
+interface AgentVariableMeta {
+  key: string;
+  label: string;
+  unit?: string;
+  kind?: string;
+  chart?: boolean;
+  description: string;
+}
+
+interface ReceivedInfluence {
+  iteration: number;
+  source: string;
+  delta_stance: number;
+  behavior: string | null;
+  adopted: boolean;
+  from_persuader: boolean;
+}
+
+interface AgentVariableRecord {
+  agent_id: number;
+  role: string;
+  leaning: string;
+  profile: string;
+  degree: number;
+  series: Record<string, number[]>;
+  received: ReceivedInfluence[];
+}
+
+interface AgentVariablesFile {
+  run: number;
+  label: string;
+  n_agents: number;
+  n_periods: number;
+  iterations: number[];
+  iteration_labels: string[];
+  variables: AgentVariableMeta[];
+  static_variables: AgentVariableMeta[];
+  agents: Record<string, AgentVariableRecord>;
+}
+
+const agentVariableCache = new Map<number, AgentVariablesFile | null>();
+
+async function loadAgentVariables(run: number): Promise<AgentVariablesFile | null> {
+  const cached = agentVariableCache.get(run);
+  if (cached !== undefined) return cached;
+  let data: AgentVariablesFile | null = null;
+  try {
+    const res = await fetch(`/data/v1/${run}/agent_variables_50_repub_${run}.json`);
+    data = res.ok ? ((await res.json()) as AgentVariablesFile) : null;
+  } catch {
+    data = null;
+  }
+  agentVariableCache.set(run, data);
+  return data;
+}
+
+/**
+ * Diverging stance colour: red = supports the policy (+1), blue = aligned
+ * with the persuaders' view (-1), slate at neutral. Matches the colour
+ * convention of the offline episode renderer (code/visualize.py).
+ */
+function stanceColor(stance: number): string {
+  const t = Math.max(-1, Math.min(1, Number.isFinite(stance) ? stance : 0));
+  const base = [148, 163, 184];
+  const target = t < 0 ? [96, 165, 250] : [248, 113, 113];
+  const w = Math.abs(t);
+  const rgb = base.map((b, i) => Math.round(b + (target[i] - b) * w));
+  return `rgb(${rgb[0]}, ${rgb[1]}, ${rgb[2]})`;
+}
+
+function formatVariable(key: string, value: number): string {
+  if (key === 'adopted') return value ? 'yes' : 'no';
+  if (Number.isInteger(value)) return String(value);
+  return value.toFixed(3);
+}
+
+/** Inline stance trajectory with a marker at the iteration on screen. */
+function StanceSparkline({ values, currentIteration }: { values: number[]; currentIteration: number }) {
+  const W = 240;
+  const H = 46;
+  const pad = 5;
+  const n = values.length;
+  if (n === 0) return null;
+  const x = (i: number) => pad + (n <= 1 ? 0 : (i * (W - 2 * pad)) / (n - 1));
+  const y = (v: number) => pad + ((1 - (Math.max(-1, Math.min(1, v)) + 1) / 2) * (H - 2 * pad));
+  const points = values.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
+  const ci = Math.max(0, Math.min(n - 1, currentIteration));
+  return (
+    <svg width={W} height={H} style={{ overflow: 'visible' }}>
+      <line
+        x1={pad} x2={W - pad} y1={y(0)} y2={y(0)}
+        stroke="rgba(148,163,184,0.35)" strokeWidth="1" strokeDasharray="3 3"
+      />
+      <polyline
+        points={points} fill="none"
+        stroke="rgba(148,163,184,0.8)" strokeWidth="1.5"
+      />
+      <circle cx={x(0)} cy={y(values[0])} r="2.5" fill="rgba(148,163,184,0.9)" />
+      <circle
+        cx={x(ci)} cy={y(values[ci])} r="4"
+        fill={stanceColor(values[ci])} stroke="#0f172a" strokeWidth="1.5"
+      />
+    </svg>
+  );
+}
