+/**
+ * The node inspector must show the *simulation* variables of the node on
+ * screen — above all its current stance — read from the per-agent sidecar
+ * (`agent_variables_50_repub_<run>.json`) that code/export_dashboard.py
+ * writes next to the Twitter-schema CSVs.
+ *
+ * The dashboard's own schema has no opinion variables, so this panel is
+ * the only place a node description can show them; it must (a) render the
+ * values at the iteration the timeline is showing, (b) name each variable
+ * and carry its description, (c) show what reached the agent, and (d) stay
+ * invisible — not broken — for runs that ship no sidecar.
+ */
+import React from 'react';
+import { render, screen, waitFor } from '@testing-library/react';
+import { AgentInspector } from '@/components/AgentInspector';
+import { useSimulationStore } from '@/store/simulationStore';
+import {
+  createMockAgent,
+  createMockNetworkState,
+  mockAgentColors,
+} from '../helpers/testUtils';
+
+jest.mock('@/store/simulationStore');
+
+// Shaped exactly like code/export_dashboard.py::_write_agent_variables
+const SIDECAR = {
+  run: 10,
+  label: 'C7 cascade',
+  n_agents: 1,
+  n_periods: 2,
+  iterations: [0, 1, 2],
+  iteration_labels: ['t0', 't1', 't2'],
+  variables: [
+    {
+      key: 'stance', label: 'Stance', unit: '[-1, +1]', kind: 'continuous',
+      chart: true,
+      description: 'Current stance toward the policy: +1 fully supports it, -1 is fully aligned with the persuaders.',
+    },
+    {
+      key: 'adopted', label: 'Adopted', kind: 'binary', chart: false,
+      description: 'Whether the agent has adopted the persuaders\' view at this iteration (sticky).',
+    },
+    {
+      key: 'exposure_cum', label: 'Exposures received', unit: 'events',
+      kind: 'count', chart: false,
+      description: 'Cumulative number of influence events that reached this agent.',
+    },
+  ],
+  static_variables: [
+    { key: 'role', label: 'Role', description: 'Whether the agent is a seed persuader or an organic user in the crowd.' },
+    { key: 'degree', label: 'Degree', description: 'Number of network neighbours the agent can be reached through.' },
+  ],
+  agents: {
+    u09: {
+      agent_id: 9,
+      role: 'organic',
+      leaning: 'persuadable',
+      profile: 'A profile about the policy.',
+      degree: 3,
+      series: {
+        stance: [0.42, 0.11, -0.37],
+        adopted: [0, 0, 1],
+        exposure_cum: [0, 1, 2],
+      },
+      received: [
+        {
+          iteration: 1, source: 'io00', delta_stance: -0.31,
+          behavior: 'emerge', adopted: false, from_persuader: true,
+        },
+        {
+          iteration: 2, source: 'u05', delta_stance: -0.48,
+          behavior: 'emerge', adopted: true, from_persuader: false,
+        },
+      ],
+    },
+  },
+};
+
+;(useSimulationStore as unknown as jest.Mock).mockReturnValue({}); // reset
+
+function selectAgent(overrides = {}) {
+  (useSimulationStore as unknown as jest.Mock).mockReturnValue({
+    selectedAgent: createMockAgent({ id: 'u09', name: 'u09' }),
+    selectAgent: jest.fn(),
+    networkState: createMockNetworkState({
+      currentIteration: 2, maxIteration: 2, runNumber: 10, ...overrides,
+    }),
+    agentColors: mockAgentColors,
+  });
+}
+
+describe('AgentInspector simulation variables', () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+    selectAgent();
+  });
+
+  it('shows the current stance at the iteration on screen', async () => {
+    global.fetch = jest.fn().mockResolvedValue({
+      ok: true, json: async () => SIDECAR,
+    }) as unknown as typeof fetch;
+
+    render(<AgentInspector />);
+
+    expect(await screen.findByText('Simulation variables')).toBeInTheDocument();
+    // iteration 2 -> stance series [0.42, 0.11, -0.37]
+    expect(screen.getByText('-0.370')).toBeInTheDocument();
+    expect(screen.getByText('Current stance')).toBeInTheDocument();
+    // the timeline position is named, not implied
+    expect(screen.getByText(/iteration 2\/2/)).toBeInTheDocument();
+  });
+
+  it('renders the other variables at the same iteration with labels', async () => {
+    global.fetch = jest.fn().mockResolvedValue({
+      ok: true, json: async () => SIDECAR,
+    }) as unknown as typeof fetch;
+
+    render(<AgentInspector />);
+    await screen.findByText('Simulation variables');
+
+    expect(screen.getByText('Adopted')).toBeInTheDocument();
+    expect(screen.getByText('Exposures received')).toBeInTheDocument();
+    // scope to each variable's card (the element carrying the hover
+    // description): bare "2" also appears in the metrics block above
+    const adoptedCard = screen.getByText('Adopted').closest('[title]');
+    expect(adoptedCard?.textContent).toContain('yes');
+    const exposureCard = screen.getByText('Exposures received').closest('[title]');
+    expect(exposureCard?.textContent).toContain('2');
+  });
+
+  it('carries each variable description as the hover title', async () => {
+    global.fetch = jest.fn().mockResolvedValue({
+      ok: true, json: async () => SIDECAR,
+    }) as unknown as typeof fetch;
+
+    const { container } = render(<AgentInspector />);
+    await screen.findByText('Simulation variables');
+
+    const titled = Array.from(container.querySelectorAll('[title]'))
+      .map((el) => el.getAttribute('title') || '');
+    expect(titled.some((t) => t.includes('Current stance toward the policy')))
+      .toBe(true);
+    expect(titled.some((t) => t.includes('Cumulative number of influence')))
+      .toBe(true);
+  });
+
+  it('lists the influences the agent actually received', async () => {
+    global.fetch = jest.fn().mockResolvedValue({
+      ok: true, json: async () => SIDECAR,
+    }) as unknown as typeof fetch;
+
+    render(<AgentInspector />);
+    await screen.findByText('Simulation variables');
+
+    expect(screen.getByText(/Influences received \(2\)/)).toBeInTheDocument();
+    expect(screen.getByText('persuader')).toBeInTheDocument(); // io00 tag
+    expect(screen.getByText('adopted')).toBeInTheDocument();   // u05 tag
+  });
+
+  it('stays hidden when the run ships no sidecar (404)', async () => {
+    // run 11, not 10: the loader caches one answer per run for the whole
+    // session, so this test must use a run no earlier test has fetched.
+    selectAgent({ runNumber: 11, maxIteration: 0, currentIteration: 0 });
+    const fetchMock = jest.fn().mockResolvedValue({
+      ok: false, json: async () => ({}),
+    }) as unknown as typeof fetch;
+    global.fetch = fetchMock;
+
+    const { container } = render(<AgentInspector />);
+    // let the effect settle, then assert the panel was never added
+    await waitFor(() => expect(fetchMock).toHaveBeenCalled());
+    expect(screen.queryByText('Simulation variables')).toBeNull();
+    expect(container.firstChild).not.toBeNull(); // the rest still renders
+  });
+});
