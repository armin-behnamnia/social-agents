          "trajectory": "output/ppo_v2_bt/live_run2/viz/trajectory.json",
          "final_adopted": 16, "mean_stance": "0.485 -> 0.181", "total_reward": 8.610},
    "9": {"label": "trained (judge + goal-delta)",
          "experiment": "output/ppo_v2_goal/live_goal_judge (campaign 6, --align judge --goal-delta)",
          "policy": "output/ppo_v2_goal/live_goal_judge/policy.pt",
          "trajectory": "output/ppo_v2_goal/live_goal_judge/viz/trajectory.json",
          "final_adopted": 19, "mean_stance": "0.485 -> 0.142", "total_reward": 9.017},
    "10": {"label": "C7 cascade (stance-ful mechanism, final policy)",
           "experiment": "output/ppo_mech_cascade/live (C7, --mechanism cascade --mech-beta-init --goal-delta --align judge)",
           "policy": "output/ppo_mech_cascade/live/policy.pt",
           "trajectory": "output/ppo_mech_cascade/live/viz_cascade/trajectory.json",
           "final_adopted": 50, "mean_stance": "-0.024 -> -0.072", "total_reward": 1.751,
           "agent_variables": "agent_variables_50_repub_10.json"},
    "11": {"label": "C8 exposure (stance-less mechanism, final policy)",
           "experiment": "output/ppo_mech_exposure/live (C8, --mechanism exposure --mech-beta-init --reward-adoption-bonus 1.0 --align judge, PERSUASION_GOAL_LAMBDA=0.2)",
           "policy": "output/ppo_mech_exposure/live/policy.pt",
           "trajectory": "output/ppo_mech_exposure/live/viz_exposure/trajectory.json",
           "final_adopted": 13, "mean_stance": "-0.024 -> -0.024 (frozen by mechanism)", "total_reward": 14.480,
           "agent_variables": "agent_variables_50_repub_11.json"}
